---
import { SITE, ADDRESS, CONTACT, SOCIAL, FOOTER_NAV } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const socials = [
  { key: 'scholar', href: SOCIAL.scholar, icon: 'scholar', label: 'Google Scholar' },
  { key: 'orcid', href: SOCIAL.orcid, icon: 'orcid', label: 'ORCID' },
  { key: 'linkedin', href: SOCIAL.linkedin, icon: 'linkedin', label: 'LinkedIn' },
].filter((s) => s.href);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="footer-lab">{SITE.name}</p>
      <p class="footer-tag">{SITE.tagline}</p>
      <p class="footer-blurb">{SITE.mission}</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <h2>Explore</h2>
      <ul>
        {FOOTER_NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-contact">
      <h2>Visit</h2>
      <address>
        {ADDRESS.institution}<br />
        {ADDRESS.building}<br />
        {ADDRESS.street}<br />
        {ADDRESS.city}, {ADDRESS.state}
      </address>
      <p class="footer-links">
        <a class="link-arrow" href={`mailto:${CONTACT.email}`}>
          <Icon name="mail" /> {CONTACT.email}
        </a>
      </p>
      {
        socials.length > 0 && (
          <ul class="footer-social">
            {socials.map((s) => (
              <li>
                <a href={s.href} aria-label={s.label} rel="me noopener" target="_blank">
                  <Icon name={s.icon} size="1.25rem" label={s.label} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="footer-cta">
      <h2>Join us</h2>
      <p>We are actively recruiting postdocs and students.</p>
      <a class="btn btn--ghost" href="/join">Open positions <Icon name="arrow-right" /></a>
    </div>
  </div>

  <div class="container footer-base">
    <p>© {year} {SITE.pi}. {SITE.institution} · {SITE.department} · Wu Tsai Institute.</p>
    <p class="muted">{SITE.description}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--yale-blue-900);
    color: #c7d6e8;
    margin-top: var(--space-2xl);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) 1.5rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: clamp(1.75rem, 1rem + 3vw, 3rem);
  }
  .site-footer h2 {
    color: #fff;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-family: var(--font-sans);
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .footer-lab {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: #fff;
    font-weight: 600;
  }
  .footer-tag {
    color: var(--accent-sky);
    font-weight: 500;
    margin-top: 0.15rem;
  }
  .footer-blurb {
    margin-top: 0.9rem;
    max-width: 32ch;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #a9bdd6;
  }
  .footer-nav ul,
  .footer-social {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-nav li { margin-bottom: 0.5rem; }
  .site-footer a { color: #c7d6e8; text-decoration: none; }
  .site-footer a:hover { color: #fff; }
  .footer-nav a:hover { text-decoration: underline; text-underline-offset: 0.2em; }

  address {
    font-style: normal;
    line-height: 1.7;
    color: #a9bdd6;
    margin-bottom: 1rem;
  }
  .footer-links .link-arrow { color: #fff; word-break: break-word; }

  .footer-social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }
  .footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    transition: background-color var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease), transform var(--dur-2) var(--ease-out);
  }
  .footer-social a:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
    transform: translateY(-2px);
  }

  .footer-cta p {
    color: #a9bdd6;
    margin-bottom: 1.1rem;
    max-width: 26ch;
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(2rem, 1rem + 3vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.85rem;
    color: #8da3c0;
  }
  .footer-base .muted { color: #7f97b4; }
</style>
